{
  "name": "robadillo-blog",
  "version": "1.0.0",
  "private": true,
  "description": "Personal site and blog — robadillo.com",
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "preview": "npx --yes serve@14 out -l 3000",
    "typecheck": "tsc --noEmit",
    "validate": "go -C tools/blogctl run . validate",
    "new": "go -C tools/blogctl run . new",
    "add": "go -C tools/blogctl run . add",
    "thumbs": "go -C tools/blogctl run . thumbs",
    "stats": "go -C tools/blogctl run . stats",
    "check": "npm run validate && npm run typecheck && npm run build",
    "hooks:install": "bash scripts/install-hooks.sh"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "next": "^16.4.0",
    "next-mdx-remote": "^6.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-pretty-code": "^0.14.5",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.5.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
