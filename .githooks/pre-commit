#!/usr/bin/env bash
#
# Runs before every commit. Keeps broken frontmatter and dead internal links
# out of main, which matters more than usual here: there is no CMS and no
# staging environment, so a bad commit is a bad deploy.
#
# Install with: npm run hooks:install
# Skip once with: git commit --no-verify

set -euo pipefail

echo "pre-commit: validating content"

if command -v go >/dev/null 2>&1; then
  go -C tools/blogctl run . validate
else
  echo "  ! Go is not installed; skipping content validation."
  echo "    CI will still run it. Install Go: https://go.dev/dl/"
fi

# Catch the obvious secret shapes before they reach a public repo. This is a
# backstop, not a scanner — the real control is that the site needs no secrets
# at all (see docs/SECURITY.md).
staged=$(git diff --cached --name-only --diff-filter=ACM)

if [ -n "$staged" ]; then
  if printf '%s\n' "$staged" | grep -qE '(^|/)\.env($|\.)' ; then
    echo "  ✗ refusing to commit a .env file" >&2
    exit 1
  fi

  patterns='AKIA[0-9A-Z]{16}|gh[pousr]_[A-Za-z0-9]{36}|sk-[A-Za-z0-9]{32,}|-----BEGIN [A-Z ]*PRIVATE KEY-----'
  if printf '%s\n' "$staged" | xargs -r grep -nIE "$patterns" 2>/dev/null; then
    echo "  ✗ the lines above look like credentials; commit blocked" >&2
    exit 1
  fi
fi

echo "pre-commit: ok"
